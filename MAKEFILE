CC=tcc

SRC=SRC
BIN=BIN

!ifdef DEBUG
OBJDIR=BUILD\DEBUG
CFLAGS=-mh -1 -I$(SRC) -n$(OBJDIR) -v -y -DDEBUG
LFLAGS=-mh -1 -v -y
OUT=$(BIN)\INV_D.EXE
!else
OBJDIR=BUILD\RELEASE
CFLAGS=-mh -1 -I$(SRC) -n$(OBJDIR) -G -O -DNDEBUG
LFLAGS=-mh -1
OUT=$(BIN)\INVADER.EXE
!endif

OBJS=$(OBJDIR)\MAIN.OBJ \
$(OBJDIR)\@BASE.OBJ \ 
$(OBJDIR)\@GRAPH.OBJ \
$(OBJDIR)\@INPUT.OBJ

all: $(OUT)

$(OUT): $(OBJS)
	$(CC) $(LFLAGS) -e$(OUT) $(OBJS)

$(OBJDIR)\MAIN.OBJ: $(SRC)\MAIN.C
	$(CC) $(CFLAGS) -c $(SRC)\MAIN.C

$(OBJDIR)\@BASE.OBJ: $(SRC)\BASE\@BASE.C
	$(CC) $(CFLAGS) -c $(SRC)\BASE\@BASE.C

$(OBJDIR)\@GRAPH.OBJ: $(SRC)\GRAPH\@GRAPH.C
	$(CC) $(CFLAGS) -c $(SRC)\GRAPH\@GRAPH.C

$(OBJDIR)\@INPUT.OBJ: $(SRC)\INPUT\@INPUT.C
	$(CC) $(CFLAGS) -c $(SRC)\INPUT\@INPUT.C

