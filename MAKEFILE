CC=tcc

SRC=SRC
BIN=BIN

!ifdef DEBUG
OBJDIR=BUILD\DEBUG
CFLAGS=-mh -1 -I$(SRC) -n$(OBJDIR) -v -y -DDEBUG
LFLAGS=-mh -1 -v -y
OUT=$(BIN)\INV_D.EXE
!else
OBJDIR=BUILD\RELEASE
CFLAGS=-mh -1 -I$(SRC) -n$(OBJDIR) -G -O -DNDEBUG
LFLAGS=-mh -1
OUT=$(BIN)\INVADER.EXE
!endif

OBJS=$(OBJDIR)\MAIN.OBJ \
$(OBJDIR)\@BASE.OBJ \ 
$(OBJDIR)\@GRAPH.OBJ \
$(OBJDIR)\@INPUT.OBJ

all: $(OUT)

$(OUT): $(OBJS)
	$(CC) $(LFLAGS) -e$(OUT) $(OBJS)

$(OBJDIR)\MAIN.OBJ: $(SRC)\MAIN.C
	$(CC) $(CFLAGS) -c $(SRC)\MAIN.C

$(OBJDIR)\@BASE.OBJ: 	$(SRC)\BASE\@BASE.C $(SRC)\BASE\@BASE.H \
						$(SRC)\BASE\COMMON.H \
						$(SRC)\BASE\BIOS.C $(SRC)\BASE\BIOS.H \
						$(SRC)\BASE\PIT.C $(SRC)\BASE\PIT.H \
						$(SRC)\BASE\MEMORY.C $(SRC)\BASE\MEMORY.H
	$(CC) $(CFLAGS) -c $(SRC)\BASE\@BASE.C

$(OBJDIR)\@GRAPH.OBJ: 	$(SRC)\GRAPH\@GRAPH.C $(SRC)\GRAPH\@GRAPH.H \
						$(SRC)\GRAPH\MODE13.C $(SRC)\GRAPH\MODE13.H \
						$(SRC)\GRAPH\VGAREGS.C $(SRC)\GRAPH\VGAREGS.H \
						$(SRC)\GRAPH\MODEX.C $(SRC)\GRAPH\MODEX.H \
						$(SRC)\GRAPH\GRAPHICS.C $(SRC)\GRAPH\GRAPHICS.H \
						$(SRC)\GRAPH\FNTMONO.C $(SRC)\GRAPH\FNTMONO.H
	$(CC) $(CFLAGS) -c $(SRC)\GRAPH\@GRAPH.C

$(OBJDIR)\@INPUT.OBJ: 	$(SRC)\INPUT\@INPUT.C $(SRC)\INPUT\@INPUT.H \
						$(SRC)\INPUT\KEYBOARD.C $(SRC)\INPUT\KEYBOARD.H \
						$(SRC)\INPUT\MOUSE.C $(SRC)\INPUT\MOUSE.H
	$(CC) $(CFLAGS) -c $(SRC)\INPUT\@INPUT.C

